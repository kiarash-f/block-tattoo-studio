NODE_ENV=development
PORT=3102

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tattoo

# Auth
ADMIN_JWT_SECRET=change-me-min-32-chars-xxxxxxxxxxxx
ADMIN_JWT_EXPIRES_IN=1d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=tattoo-studio/booking-requests

# App
PUBLIC_BASE_URL=https://your-domain.com
BOOKING_LINK_TOKEN_PEPPER=change-me-min-32-chars-xxxxxxxxxxxx

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Google Reviews
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Anthropic AI
ANTHROPIC_API_KEY=

# Transactional Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@your-domain.com
STUDIO_NAME=Tattoo Studio
STUDIO_ADDRESS=
STUDIO_PHONE=
STUDIO_WEBSITE=

# Shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

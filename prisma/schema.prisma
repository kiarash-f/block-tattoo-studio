generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// Enums
//
enum BookingType {
  APPOINTMENT
  CONSULTATION
  COVER_UP
  WALK_IN
}

enum PreferredTimeOfDay {
  MORNING
  AFTERNOON
  EVENING
  ANY
}

enum BookingLinkScope {
  INTAKE_CONTINUE
  UPLOAD
  VIEW
}

enum BookingLinkStatus {
  ACTIVE
  REVOKED
  EXPIRED
  CONSUMED
}

enum BookingStatus {
  PENDING_CONSULT
  CONSULT_APPROVED
  CONSULT_NO_SHOW
  TATTOO_SCHEDULED
  COMPLETED
  CANCELLED
}

enum BudgetRange {
  UNDER_200
  B200_400
  B400_700
  B700_1000
  B1000_1500
  B1500_2000
  OVER_2000
}

enum IntakeSource {
  DIRECT
  INSTAGRAM
  FACEBOOK
  GOOGLE
  TIKTOK
  OTHER
}

enum UploadKind {
  REFERENCE
  MEDICAL
  OTHER
}

enum ArtistStatus {
  ACTIVE
  INACTIVE
}

enum StationStatus {
  ACTIVE
  INACTIVE
}

enum AssignmentRole {
  PRIMARY
  SECONDARY
  ASSISTANT
  GUEST
}

enum CancelReason {
  CLIENT_CANCELLED
  NO_SHOW
  STUDIO_CANCELLED
  OTHER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum GuestBookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  NO_SHOW
  EXPIRED
}

enum PaymentSource {
  TATTOO
  VOUCHER
  GUEST_TABLE
}

enum PaymentMethod {
  CASH
  LINK
}

enum PaymentStatus {
  PAID
  REFUNDED
  CANCELLED
}

enum VoucherType {
  FULL_DAY
  HALF_DAY
  CUSTOM
}

// German VAT treatment (UStG §3 Abs. 13–15). SINGLE_PURPOSE: place of supply +
// VAT rate are known at issuance → VAT recognized at SALE (the only path
// implemented now). MULTI_PURPOSE: VAT recognized at REDEMPTION. Stored from day
// one so the multi-purpose path can be added later without a backfill.
enum VoucherTreatment {
  SINGLE_PURPOSE
  MULTI_PURPOSE
}

enum VoucherStatus {
  PENDING_PAYMENT // created, awaiting Stripe confirmation — NOT yet redeemable
  VALID //           paid & active; redeemable
  REDEEMED //        used once (no partial redemption)
  CANCELLED
}

enum VoucherDelivery {
  EMAIL //          emailed only (always sent)
  EMAIL_AND_POST // emailed + physically mailed by admin (shipping fields set)
}

//
// Models
//
model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // BookingRequest relations 
  reviewedBookingRequests  BookingRequest[] @relation("BookingReviewedBy")
  checkedInBookingRequests BookingRequest[] @relation("BookingCheckedInBy")

  // Medical/Consent submission audit
  medicalDeclarationsSubmitted MedicalDeclaration[] @relation("MedicalSubmittedBy")
  consentsSubmitted            Consent[]            @relation("ConsentSubmittedBy")

  // Articles
  articles Article[]

  // Payments created manually (cash) by this admin
  payments Payment[] @relation("PaymentCreatedBy")

  // Payments this admin marked CANCELLED
  cancelledPayments Payment[] @relation("PaymentCancelledBy")

  // Vouchers redeemed (scanned) by this admin
  redeemedVouchers VoucherSale[]

  @@index([isActive])
}

model Client {
  id        String    @id @default(uuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  instagram String?
  birthday  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookingRequests BookingRequest[]

  @@index([email])
  @@index([phone])
}

model BookingRequest {
  id     String        @id @default(uuid())
  status BookingStatus @default(PENDING_CONSULT)

  // client relation
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  // core request fields
  placement       String?
  sizeDescription String?
  styleNotes      String?
  description     String
  budgetRange     BudgetRange
  referencesNotes String?

  // artist selection / preference
  preferredArtistName String?
  studioChooses       Boolean @default(true)

  // tracking fields
  source      IntakeSource @default(DIRECT)
  utmCampaign String?
  utmAdset    String?
  utmAd       String?
  referrer    String?
  landingPath String?

  // admin handling
  adminNotes         String?
  internalStatusNote String?
  reviewedAt         DateTime?
  reviewedByAdminId  String?
  reviewedByAdmin    AdminUser? @relation("BookingReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  // ✅ in-studio (admin-only)
  checkedInAt         DateTime?
  checkedInByAdminId  String?
  checkedInByAdmin    AdminUser? @relation("BookingCheckedInBy", fields: [checkedInByAdminId], references: [id], onDelete: SetNull)
  inStudioCompletedAt DateTime?

  // scheduling & links
  tokens      BookingLinkToken[]
  assignments BookingAssignment[]
  bookingType BookingType         @default(APPOINTMENT)

  // agreed total price for the tattoo, in integer cents. Set by admin at
  // scheduling (schedule-tattoo / walk-in). Null = not priced yet (consults,
  // historical rows). Remaining balance is always computed fresh from payments.
  agreedPriceCents Int?

  // consult slot
  consultDate   DateTime?    @db.Date
  consultSlotId String?
  consultSlot   ConsultSlot? @relation("ConsultSlotBookings", fields: [consultSlotId], references: [id], onDelete: SetNull)

  // tattoo sessions (phase 5)
  tattooSessions TattooSession[]

  // payments (generic payment foundation; target = TATTOO)
  payments Payment[]

  // Reserved (NOT wired): vouchers redeemed against this booking. Inverse of the
  // future redemption-to-booking attribution FK on VoucherSale. Nothing sets it.
  redeemedVouchers VoucherSale[]

  // lifecycle timestamps
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  approvedAt   DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason CancelReason?

  // in-studio forms (optional; filled in studio)
  medicalDeclaration MedicalDeclaration?
  consent            Consent?

  // uploads (references etc.)
  uploads Upload[]

  // preferred time window (intake)
  preferredDateFrom  DateTime?
  preferredDateTo    DateTime?
  preferredTimeOfDay PreferredTimeOfDay?
  preferredDaysNote  String?

  @@index([status, createdAt])
  @@index([clientId, createdAt])
  @@index([createdAt])
  @@index([source, createdAt])
  @@index([bookingType, createdAt])
  @@index([source, bookingType, createdAt])
  @@index([approvedAt])
  @@index([completedAt])
  @@index([cancelledAt])
  @@index([status, approvedAt])
  @@index([status, completedAt])
  @@index([preferredDateFrom])
  @@index([preferredDateTo])
  @@index([checkedInAt])
  @@index([inStudioCompletedAt])
  @@index([consultSlotId])
  @@index([reviewedByAdminId])
  @@index([checkedInByAdminId])
}

model MedicalDeclaration {
  id               String         @id @default(uuid())
  bookingRequestId String         @unique
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  // medical questionnaire (filled in studio)
  hasAllergies         Boolean
  allergiesDetails     String?
  hasSkinCondition     Boolean
  skinConditionDetails String?
  isPregnantOrNursing  Boolean
  hasHeartCondition    Boolean
  hasDiabetes          Boolean
  takesBloodThinners   Boolean
  takesMedication      Boolean
  medicationDetails    String?
  otherNotes           String?

  // audit
  submittedAt        DateTime?
  submittedByAdminId String?
  submittedByAdmin   AdminUser? @relation("MedicalSubmittedBy", fields: [submittedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Consent {
  id               String         @id @default(uuid())
  bookingRequestId String         @unique
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  // legal flags (filled in studio)
  isAdultConfirmed Boolean
  termsAccepted    Boolean
  privacyAccepted  Boolean

  // signature/identity (optional)
  fullName String?
  signedAt DateTime?

  // audit
  submittedAt        DateTime?
  submittedByAdminId String?
  submittedByAdmin   AdminUser? @relation("ConsentSubmittedBy", fields: [submittedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Upload {
  id               String         @id @default(uuid())
  bookingRequestId String
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  kind         UploadKind
  originalName String?
  mimeType     String?
  bytes        Int?

  cloudinaryPublicId String
  secureUrl          String

  createdAt         DateTime          @default(now())
  createdViaTokenId String?
  createdViaToken   BookingLinkToken? @relation(fields: [createdViaTokenId], references: [id], onDelete: SetNull)

  @@index([bookingRequestId, createdAt])
  @@index([createdViaTokenId])
}

model BookingLinkToken {
  id String @id @default(cuid())

  bookingRequestId String
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  // store hash only (NEVER store raw secret)
  secretHash String

  scopes BookingLinkScope[]
  status BookingLinkStatus  @default(ACTIVE)

  expiresAt DateTime

  // auditing / observability
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  useCount   Int       @default(0)

  revokedAt    DateTime?
  revokeReason String?

  // who generated it (kept as id only for now)
  createdByAdminId String?

  createdUploads Upload[]

  @@index([bookingRequestId])
  @@index([status, expiresAt])
  @@index([createdByAdminId])
}

model Artist {
  id          String       @id @default(cuid())
  studioId    String?
  displayName String
  handle      String?      @unique
  slug        String?      @unique // new (nullable for safe migration)
  email       String?      @unique
  phone       String?
  status      ArtistStatus @default(ACTIVE)

  bio       String?
  bioDe     String?
  bioEn     String?
  avatarUrl String?
  coverUrl  String? // new

  // Featured guest artist promotion (surfaces only on the public profile page).
  // availableFrom/availableTo are display-only date text; they gate nothing.
  isFeaturedGuest Boolean   @default(false)
  availableFrom   DateTime? @db.Date
  availableTo     DateTime? @db.Date
  instagram       String? // public contact handle for featured guests

  works ArtistWork[] // new relation

  assignments    BookingAssignment[]
  tattooSessions TattooSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId, status])
  @@index([displayName])
  @@index([slug])
}

model ArtistWork {
  id          String        @id @default(cuid())
  title       String
  titleDe     String?
  titleEn     String?
  coverUrl    String
  tags        String[] // hashtags
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, createdAt])
  @@index([status, createdAt])
  @@index([tags])
}

model StudioStation {
  id       String        @id @default(cuid())
  studioId String?
  name     String // e.g. "Station 1", "Room A"
  code     String? // e.g. "S1", "RM-A"
  status   StationStatus @default(ACTIVE)

  assignments    BookingAssignment[]
  tattooSessions TattooSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studioId, name]) // avoids duplicates per studio (studioId can be null now)
  @@index([studioId, status])
}

model BookingAssignment {
  id String @id @default(cuid())

  bookingRequestId String
  artistId         String
  stationId        String?

  role AssignmentRole @default(PRIMARY)

  // scheduling (startsAt is used for appointment time)
  startsAt DateTime?
  endsAt   DateTime?
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  artist         Artist         @relation(fields: [artistId], references: [id], onDelete: Restrict)
  station        StudioStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@unique([bookingRequestId, artistId, role])
  @@index([bookingRequestId])
  @@index([artistId])
  @@index([stationId])
  @@index([startsAt])
  @@index([role, startsAt]) // daily calendar filter: role=PRIMARY + startsAt range
}

model Article {
  id          String        @id @default(cuid())
  title       String
  titleDe     String?
  titleEn     String?
  slug        String        @unique
  excerpt     String?
  excerptDe   String?
  excerptEn   String?
  content     String
  contentDe   String?
  contentEn   String?
  coverUrl    String?
  tags        String[]
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?

  authorId String?
  author   AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
  @@index([tags])
}

model ConsultSlot {
  id       String   @id @default(cuid())
  date     DateTime @db.Date
  maxCount Int      @default(3)

  bookings BookingRequest[] @relation("ConsultSlotBookings")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

// ─── Phase 10: Guest Artist Station Booking ──────────────────────────────────

model StationConfig {
  id                     String   @id @default(cuid())
  totalTables            Int
  pricePerDayCents       Int
  monthlyDiscountPercent Float    @default(10)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model GuestArtistBooking {
  id               String             @id @default(cuid())
  name             String
  phone            String
  email            String
  startDate        DateTime           @db.Date
  endDate          DateTime           @db.Date
  numberOfTables   Int
  totalPriceCents  Int
  discountApplied  Float
  acknowledgment   Boolean
  stripeSessionId  String?
  stripePaymentUrl String?
  status           GuestBookingStatus @default(PENDING_PAYMENT)
  // GoBD (§8.3): soft-delete. A booking can be the target of a Payment, so it is
  // never hard-deleted; `remove()` stamps archivedAt and every active view
  // (lists, availability/capacity) filters archivedAt = null. onDelete: Restrict
  // on the Payment FK still guards paid rows regardless.
  archivedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // payments (generic payment foundation; target = GUEST_TABLE).
  // Existing stripeSessionId/stripePaymentUrl/status columns are unchanged.
  payments Payment[]

  @@index([status])
  @@index([startDate, endDate])
  @@index([email])
  @@index([archivedAt])
}

model TattooSession {
  id               String         @id @default(cuid())
  bookingRequestId String
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Restrict)

  stationId String?
  station   StudioStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  // scheduledDate = the calendar DAY the tattoo happens (kept as-is).
  scheduledDate DateTime
  // Clock-time window within that day (e.g. 15:00–17:00), full ISO timestamps —
  // follows the BookingAssignment.startsAt/endsAt precedent (no time-only type
  // exists). Nullable at the DB so pre-feature rows and partial edits stay valid;
  // REQUIRED at the app layer when scheduling via schedule-tattoo / walk-in.
  startsAt      DateTime?
  endsAt        DateTime?
  completedAt   DateTime?
  notes         String?

  // GoBD (§8.3): soft-delete. Sessions carry scheduling history tied to booking
  // (and thus payment) context, so `deleteTattooSession()` stamps archivedAt
  // instead of hard-deleting. Active views and the artist-collision check filter
  // archivedAt = null.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingRequestId])
  @@index([artistId])
  @@index([stationId])
  @@index([scheduledDate])
  // Supports the per-artist same-day collision lookup (artistId + scheduledDate).
  @@index([artistId, scheduledDate])
  @@index([archivedAt])
}

// ─── Generic Payment Foundation ──────────────────────────────────────────────
// One row per realized money event. A row exists only when money is received
// (Stripe webhook for LINK, admin action for CASH). No PENDING state.
model Payment {
  id String @id @default(cuid())

  source PaymentSource // analytics dimension; always set, independent of which FK is populated
  method PaymentMethod // CASH | LINK
  status PaymentStatus @default(PAID)

  currency String @default("EUR")

  // money — integer cents (never Float)
  grossCents     Int // what the customer pays/paid
  netCents       Int // snapshot, frozen at creation
  vatAmountCents Int // snapshot; invariant: netCents + vatAmountCents == grossCents
  vatRateBps     Int // applied VAT rate in basis points (1900 = 19%), snapshotted

  paidAt DateTime // money-received timestamp (analytics time axis)

  // ─── Polymorphic target: separate nullable FKs + source discriminator ───────
  bookingRequestId String?
  bookingRequest   BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: Restrict)

  guestArtistBookingId String?
  guestArtistBooking   GuestArtistBooking? @relation(fields: [guestArtistBookingId], references: [id], onDelete: Restrict)

  voucherSaleId String?
  voucherSale   VoucherSale? @relation(fields: [voucherSaleId], references: [id], onDelete: Restrict)

  // ─── Stripe linkage (null for cash) ─────────────────────────────────────────
  stripeSessionId       String? @unique // idempotency key for link payments
  stripePaymentIntentId String? // refund matching (charge.refunded)
  stripeChargeId        String? // alternate refund-match key

  // ─── Cash double-submit protection (M2) ─────────────────────────────────────
  // Client-generated key giving cash the same one-row-per-intent guarantee the
  // unique stripeSessionId gives LINK. Null for link payments and for cash
  // clients that don't send one, so the unique index only constrains rows that
  // opted in (Postgres treats each NULL as distinct).
  cashIdempotencyKey String? @unique

  // ─── Refunds (partial supported by subtracting refundedAmountCents) ─────────
  // LOCKED REQUIREMENT (refund feature, not yet built): over-refund must be
  // HARD-BLOCKED — a refund may never exceed the booking's paid total
  // (SUM(grossCents) − SUM(refundedAmountCents) over PAID rows). Enforce this as
  // the FIRST guard in the future refund flow. Intentionally not implemented
  // here (no refund path exists yet; a guard with nothing to guard is dead code).
  refundedAt          DateTime?
  refundedAmountCents Int?

  // ─── Audit ──────────────────────────────────────────────────────────────────
  createdByAdminId String? // null = webhook-created (LINK); set = admin-created (CASH)
  createdByAdmin   AdminUser? @relation("PaymentCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  note             String?

  // ─── Cancellation (owner marks a payment no-longer-counting; cash refund) ────
  // A CANCELLED payment is excluded from revenue + booking balance (both filter
  // status = PAID), so cancelling is the studio's "doesn't count anymore" action.
  cancelledAt        DateTime?
  cancelledByAdminId String?
  cancelledByAdmin   AdminUser? @relation("PaymentCancelledBy", fields: [cancelledByAdminId], references: [id], onDelete: SetNull)
  // GoBD (§8.3): cancellation reason lives in its own set-once field so the
  // original `note` is never rewritten. Written exactly once, atomically, on the
  // PAID → CANCELLED conditional update; a CANCELLED payment can't transition
  // again, so this is effectively append-only.
  cancellationReason String?

  // §14 UStG invoice for this realized payment (1:1). Created in the SAME
  // transaction as the Payment, so a PAID payment always has exactly one invoice.
  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, source, paidAt]) // primary: paid revenue by source over range
  @@index([paidAt])
  @@index([source, paidAt])
  @@index([bookingRequestId])
  @@index([guestArtistBookingId])
  @@index([voucherSaleId])
  @@index([refundedAt])
  @@index([createdByAdminId])
  @@index([cancelledByAdminId])
}

// ─── Gutschein (Gift Voucher) Shop ───────────────────────────────────────────
// VoucherProduct = the admin-configured template/batch (type + De/En name +
// price + discount). VoucherSale = an individual issued voucher (unique code,
// status, buyer, delivery, frozen VAT split, Payment link). All money is integer
// cents. A redeemed voucher records NO Payment — money is taken once, at sale.

model VoucherProduct {
  id   String      @id @default(cuid())
  type VoucherType

  // De/En paired naming (base + auto-translated variants), matching Article.
  name   String
  nameDe String?
  nameEn String?

  // Gross price in integer cents. Null for CUSTOM (buyer enters the amount at
  // purchase, validated ≥ €100). Required for FULL_DAY/HALF_DAY (service layer).
  priceCents Int?

  // Whole-percent discount applied to FULL_DAY/HALF_DAY only (rejected on CUSTOM
  // at the service layer). Discounted gross is rounded half-up to whole cents,
  // and the VAT split derives from that final integer gross.
  discountPercent Int @default(0)

  // VAT classification for this product, snapshotted onto each sale at purchase.
  voucherTreatment VoucherTreatment @default(SINGLE_PURPOSE)

  // Admin soft-toggle: inactive products stay sellable history (existing sales
  // keep their FK) but are hidden from the public shop. Deactivate instead of
  // delete (which onDelete: Restrict would block once sales exist anyway).
  isActive Boolean @default(true)

  sales VoucherSale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

model VoucherSale {
  id String @id @default(cuid())

  // Unique, raw-stored code (printed / encoded into the QR — NEVER hashed, unlike
  // BookingLinkToken; the buyer must be able to read and present it).
  code String @unique

  productId String
  product   VoucherProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  status           VoucherStatus    @default(PENDING_PAYMENT)
  voucherTreatment VoucherTreatment @default(SINGLE_PURPOSE) // snapshot from product

  // ─── Buyer ──────────────────────────────────────────────────────────────────
  buyerName  String
  buyerEmail String

  // ─── Delivery ───────────────────────────────────────────────────────────────
  delivery           VoucherDelivery @default(EMAIL)
  // POST shipping — set only when delivery = EMAIL_AND_POST. Admin mails by hand;
  // shippedAt stamps when that physical send happened.
  shippingName       String?
  shippingLine1      String?
  shippingLine2      String?
  shippingPostalCode String?
  shippingCity       String?
  shippingCountry    String?
  shippedAt          DateTime?

  // ─── VAT split — frozen at sale, self-contained for invoicing ───────────────
  // Derived from the discounted gross via the shared computeVatSplit.
  // invariant: netCents + vatAmountCents == grossCents
  grossCents     Int
  netCents       Int
  vatAmountCents Int
  vatRateBps     Int

  // ─── Redemption: standalone status flip + audit; no partial redemption ──────
  redeemedAt        DateTime?
  redeemedByAdminId String?
  redeemedByAdmin   AdminUser? @relation(fields: [redeemedByAdminId], references: [id], onDelete: SetNull)

  // Reserved FK slot for future redemption-to-booking attribution. NOT wired —
  // nothing populates it yet (vouchers redeem standalone for now).
  redeemedAgainstBookingId String?
  redeemedAgainstBooking   BookingRequest? @relation(fields: [redeemedAgainstBookingId], references: [id], onDelete: SetNull)

  // Payment(s) for this sale (generic payment foundation; source = VOUCHER).
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([productId])
  @@index([buyerEmail])
  @@index([redeemedByAdminId])
  @@index([redeemedAgainstBookingId])
}

// ─── Invoicing (§14 UStG) ────────────────────────────────────────────────────
// One immutable invoice per realized (PAID) Payment, created in the SAME
// transaction as the Payment. Snapshots the §14 mandatory fields (studio
// identity, invoice date, net/VAT/gross + rate) so the record is self-contained
// even if config or the payment later changes. NEVER edited or deleted:
// cancelling the underlying payment does NOT retract the invoice (German law
// requires a Storno/credit note — deferred, see AUDIT.md §8.3).
//
// The sequential number is per-year and GAP-FREE. It is allocated by the DB via
// InvoiceCounter inside the payment transaction (INSERT ... ON CONFLICT DO
// UPDATE ... RETURNING) — never computed in app code — so concurrent payments
// serialize on the counter row lock and a rolled-back payment returns its number
// to the pool (no gap). `year` + `number` together are the sequence; the
// zero-padded `formattedNumber` (YYYY-000001) is the human-facing id.
model Invoice {
  id String @id @default(cuid())

  // Gap-free sequence: unique per (year, number); formattedNumber is the display id.
  year            Int
  number          Int
  formattedNumber String @unique

  issuedAt DateTime @default(now()) // §14 invoice date (= when the payment was recorded)

  // ─── Studio identity snapshot (§14 Abs. 4 Nr. 1–2) ──────────────────────────
  // Copied from config at issue time. §14 accepts EITHER Steuernummer OR
  // USt-IdNr, so a single taxNumber field holds whichever is configured.
  studioName      String
  studioAddress   String
  studioTaxNumber String
  studioPhone     String?
  studioWebsite   String?

  // ─── Amount snapshot (§14 Abs. 4 Nr. 7–8) — integer cents, from the Payment ──
  currency       String @default("EUR")
  netCents       Int
  vatAmountCents Int
  grossCents     Int
  vatRateBps     Int

  // ─── Recipient snapshot (best-available; full B2B address is a later concern) ─
  customerName  String?
  customerEmail String?
  source        PaymentSource // TATTOO | GUEST_TABLE | VOUCHER
  reference     String? // target record id, paired with source

  // ─── Link back to the payment (1:1) ─────────────────────────────────────────
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([year, number]) // the gap-free per-year sequence
  @@index([issuedAt])
}

// Single-purpose counter backing the gap-free invoice numbers: one row per year,
// holding the last number issued that year. Mutated ONLY via the atomic
// allocate-in-transaction statement described on Invoice; never read-then-write
// in app code.
model InvoiceCounter {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

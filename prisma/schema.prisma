generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// Enums
//
enum BookingType {
  APPOINTMENT
  CONSULTATION
  COVER_UP
  WALK_IN
}

enum PreferredTimeOfDay {
  MORNING
  AFTERNOON
  EVENING
  ANY
}

enum BookingLinkScope {
  INTAKE_CONTINUE
  UPLOAD
  VIEW
}

enum BookingLinkStatus {
  ACTIVE
  REVOKED
  EXPIRED
  CONSUMED
}

enum BookingStatus {
  NEW
  IN_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum BudgetRange {
  UNDER_200
  B200_400
  B400_700
  B700_1000
  B1000_1500
  B1500_2000
  OVER_2000
}

enum IntakeSource {
  DIRECT
  INSTAGRAM
  FACEBOOK
  GOOGLE
  TIKTOK
  OTHER
}

enum UploadKind {
  REFERENCE
  MEDICAL
  OTHER
}

enum ArtistStatus {
  ACTIVE
  INACTIVE
}

enum StationStatus {
  ACTIVE
  INACTIVE
}

enum AssignmentRole {
  PRIMARY
  SECONDARY
  ASSISTANT
  GUEST
}

enum CancelReason {
  CLIENT_CANCELLED
  NO_SHOW
  STUDIO_CANCELLED
  OTHER
}

//
// Models
//
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // BookingRequest relations 
  reviewedBookingRequests   BookingRequest[] @relation("BookingReviewedBy")
  checkedInBookingRequests  BookingRequest[] @relation("BookingCheckedInBy")

  // Medical/Consent submission audit
  medicalDeclarationsSubmitted MedicalDeclaration[] @relation("MedicalSubmittedBy")
  consentsSubmitted            Consent[]            @relation("ConsentSubmittedBy")

  @@index([isActive])
}

model Client {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  instagram String?
  birthday  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingRequests BookingRequest[]

  @@index([email])
  @@index([phone])
}

model BookingRequest {
  id     String        @id @default(uuid())
  status BookingStatus @default(NEW)

  // client relation
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  // core request fields
  placement       String?
  sizeDescription String?
  styleNotes      String?
  description     String
  budgetRange     BudgetRange
  referencesNotes String?

  // artist selection / preference
  preferredArtistName String?
  studioChooses       Boolean @default(true)

  // tracking fields
  source      IntakeSource @default(DIRECT)
  utmCampaign String?
  utmAdset    String?
  utmAd       String?
  referrer    String?
  landingPath String?

  // admin handling
  adminNotes         String?
  internalStatusNote String?
  reviewedAt         DateTime?
  reviewedByAdminId  String?
  reviewedByAdmin    AdminUser? @relation("BookingReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  // ✅ in-studio (admin-only)
  checkedInAt         DateTime?
  checkedInByAdminId  String?
  checkedInByAdmin    AdminUser? @relation("BookingCheckedInBy", fields: [checkedInByAdminId], references: [id], onDelete: SetNull)
  inStudioCompletedAt DateTime?

  // scheduling & links
  tokens      BookingLinkToken[]
  assignments BookingAssignment[]
  bookingType BookingType @default(APPOINTMENT)

  // lifecycle timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  approvedAt   DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason CancelReason?

  // in-studio forms (optional; filled in studio)
  medicalDeclaration MedicalDeclaration?
  consent            Consent?

  // uploads (references etc.)
  uploads Upload[]

  // preferred time window (intake)
  preferredDateFrom   DateTime?
  preferredDateTo     DateTime?
  preferredTimeOfDay  PreferredTimeOfDay?
  preferredDaysNote   String?

  @@index([status, createdAt])
  @@index([clientId, createdAt])
  @@index([createdAt])
  @@index([source, createdAt])
  @@index([bookingType, createdAt])
  @@index([source, bookingType, createdAt])
  @@index([approvedAt])
  @@index([completedAt])
  @@index([cancelledAt])
  @@index([status, approvedAt])
  @@index([status, completedAt])
  @@index([preferredDateFrom])
  @@index([preferredDateTo])
  @@index([checkedInAt])
  @@index([inStudioCompletedAt])
}

model MedicalDeclaration {
  id               String         @id @default(uuid())
  bookingRequestId String         @unique
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  // medical questionnaire (filled in studio)
  hasAllergies         Boolean
  allergiesDetails     String?
  hasSkinCondition     Boolean
  skinConditionDetails String?
  isPregnantOrNursing  Boolean
  hasHeartCondition    Boolean
  hasDiabetes          Boolean
  takesBloodThinners   Boolean
  takesMedication      Boolean
  medicationDetails    String?
  otherNotes           String?

  // audit
  submittedAt        DateTime?
  submittedByAdminId String?
  submittedByAdmin   AdminUser? @relation("MedicalSubmittedBy", fields: [submittedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Consent {
  id               String         @id @default(uuid())
  bookingRequestId String         @unique
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  // legal flags (filled in studio)
  isAdultConfirmed Boolean
  termsAccepted    Boolean
  privacyAccepted  Boolean

  // signature/identity (optional)
  fullName String?
  signedAt DateTime?

  // audit
  submittedAt        DateTime?
  submittedByAdminId String?
  submittedByAdmin   AdminUser? @relation("ConsentSubmittedBy", fields: [submittedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Upload {
  id               String         @id @default(uuid())
  bookingRequestId String
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  kind         UploadKind
  originalName String?
  mimeType     String?
  bytes        Int?

  cloudinaryPublicId String
  secureUrl          String

  createdAt         DateTime          @default(now())
  createdViaTokenId String?
  createdViaToken   BookingLinkToken? @relation(fields: [createdViaTokenId], references: [id], onDelete: SetNull)

  @@index([bookingRequestId, createdAt])
  @@index([createdViaTokenId])
}

model BookingLinkToken {
  id String @id @default(cuid())

  bookingRequestId String
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  // store hash only (NEVER store raw secret)
  secretHash String

  scopes BookingLinkScope[]
  status BookingLinkStatus @default(ACTIVE)

  expiresAt DateTime

  // auditing / observability
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  useCount   Int       @default(0)

  revokedAt    DateTime?
  revokeReason String?

  // who generated it (kept as id only for now)
  createdByAdminId String?

  createdUploads Upload[]

  @@index([bookingRequestId])
  @@index([status, expiresAt])
}

model Artist {
  id          String       @id @default(cuid())
  studioId    String?      // keep nullable for single-shop now; later required
  displayName String
  handle      String?      @unique // optional: "alex-ink"
  email       String?      @unique
  phone       String?
  status      ArtistStatus @default(ACTIVE)

  // Optional future metadata
  bio       String?
  avatarUrl String?

  assignments BookingAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId, status])
  @@index([displayName])
}

model StudioStation {
  id       String        @id @default(cuid())
  studioId String?
  name     String        // e.g. "Station 1", "Room A"
  code     String?       // e.g. "S1", "RM-A"
  status   StationStatus @default(ACTIVE)

  assignments BookingAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId, status])
  @@unique([studioId, name]) // avoids duplicates per studio (studioId can be null now)
}

model BookingAssignment {
  id String @id @default(cuid())

  bookingRequestId String
  artistId         String
  stationId        String?

  role AssignmentRole @default(PRIMARY)

  // scheduling (startsAt is used for appointment time)
  startsAt DateTime?
  endsAt   DateTime?
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  artist         Artist         @relation(fields: [artistId], references: [id], onDelete: Restrict)
  station        StudioStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@index([bookingRequestId])
  @@index([artistId])
  @@index([stationId])
  @@unique([bookingRequestId, artistId, role])
}